{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/classes/layout,_N_T_/classes/page,_N_T_/classes"}},"html":"<!DOCTYPE html><html lang=\"fa\" dir=\"rtl\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/be242b31a49bf824.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-1ccb984bef8932a9.js\"/><script src=\"/_next/static/chunks/fd9d1056-a6af9eeeb31f5ac9.js\" async=\"\"></script><script src=\"/_next/static/chunks/117-085011db377e8295.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-44fe08c68848fa24.js\" async=\"\"></script><script src=\"/_next/static/chunks/972-424429d3ad2bc017.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/classes/page-618e2559025fe1a1.js\" async=\"\"></script><script src=\"/_next/static/chunks/438-8687b529be8d9408.js\" async=\"\"></script><script src=\"/_next/static/chunks/993-880af5fae89bd981.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-cc6fa4975068d5a4.js\" async=\"\"></script><script src=\"/_next/static/chunks/649-a996a0b34b144938.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-c9c02bd3e72b9265.js\" async=\"\"></script><title>کلاس‌های باشگاه | باشگاه آوا</title><meta name=\"description\" content=\"همه کلاس‌های باشگاه آوا — یوگا، کراس فیت، TRX، تکواندو، ایروبیک، ژیمناستیک و بیشتر؛ با برنامه هفتگی و مربیان هر سانس.\"/><meta name=\"keywords\" content=\"باشگاه بانوان,ایروبیک,یوگا,پیلاتس,زومبا,کراس‌فیت\"/><meta property=\"og:title\" content=\"باشگاه ورزشی بانوان آوا\"/><meta property=\"og:description\" content=\"کلاس‌های تخصصی ورزشی بانوان\"/><meta property=\"og:locale\" content=\"fa_IR\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"باشگاه ورزشی بانوان آوا\"/><meta name=\"twitter:description\" content=\"کلاس‌های تخصصی ورزشی بانوان\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon\" sizes=\"16x16\"/><script src=\"/_next/static/chunks/polyfills-42372ed130431b0a.js\" noModule=\"\"></script></head><body class=\"__variable_95de7e font-sans antialiased\"><section aria-label=\"Notifications alt+T\" tabindex=\"-1\" aria-live=\"polite\" aria-relevant=\"additions text\" aria-atomic=\"false\" data-react-aria-top-layer=\"true\"></section><header class=\"sticky top-0 z-50 border-b border-primary-100 bg-cream/90 backdrop-blur supports-[backdrop-filter]:bg-cream/75\"><div class=\"container-site flex h-16 items-center justify-between\"><a class=\"flex items-center gap-2 text-primary-700\" href=\"/\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-dumbbell h-6 w-6 rotate-90\" aria-hidden=\"true\"><path d=\"M17.596 12.768a2 2 0 1 0 2.829-2.829l-1.768-1.767a2 2 0 0 0 2.828-2.829l-2.828-2.828a2 2 0 0 0-2.829 2.828l-1.767-1.768a2 2 0 1 0-2.829 2.829z\"></path><path d=\"m2.5 21.5 1.4-1.4\"></path><path d=\"m20.1 3.9 1.4-1.4\"></path><path d=\"M5.343 21.485a2 2 0 1 0 2.829-2.828l1.767 1.768a2 2 0 1 0 2.829-2.829l-6.364-6.364a2 2 0 1 0-2.829 2.829l1.768 1.767a2 2 0 0 0-2.828 2.829z\"></path><path d=\"m9.6 14.4 4.8-4.8\"></path></svg><span class=\"text-lg font-bold\">باشگاه آوا</span></a><nav class=\"hidden items-center gap-6 md:flex\" aria-label=\"ناوبری اصلی\"><a class=\"text-sm font-medium text-plum/80 transition-colors hover:text-primary-600\" href=\"/#classes\">کلاس‌ها</a><a class=\"text-sm font-medium text-plum/80 transition-colors hover:text-primary-600\" href=\"/#trainers\">مربیان</a><a class=\"text-sm font-medium text-plum/80 transition-colors hover:text-primary-600\" href=\"/#schedule\">برنامه هفتگی</a><a class=\"text-sm font-medium text-plum/80 transition-colors hover:text-primary-600\" href=\"/#gallery\">گالری</a><a class=\"text-sm font-medium text-plum/80 transition-colors hover:text-primary-600\" href=\"/#pricing\">تعرفه‌ها</a><a class=\"text-sm font-medium text-plum/80 transition-colors hover:text-primary-600\" href=\"/#testimonials\">نظرات</a><a class=\"text-sm font-medium text-plum/80 transition-colors hover:text-primary-600\" href=\"/#contact\">تماس</a></nav><div class=\"hidden items-center gap-3 md:flex\"><a class=\"rounded-full px-4 py-2 text-sm font-medium text-primary-700 hover:bg-primary-50\" href=\"/login\">ورود</a><a class=\"rounded-full bg-primary-500 px-4 py-2 text-sm font-medium text-white shadow-soft transition-colors hover:bg-primary-600\" href=\"/login\">ثبت‌نام</a></div><button type=\"button\" class=\"rounded-md p-2 text-primary-700 md:hidden\" aria-label=\"باز کردن منو\" aria-expanded=\"false\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-menu h-6 w-6\" aria-hidden=\"true\"><path d=\"M4 5h16\"></path><path d=\"M4 12h16\"></path><path d=\"M4 19h16\"></path></svg></button></div><div class=\"border-t border-primary-100 bg-cream md:hidden hidden\"><nav class=\"container-site flex flex-col gap-1 py-4\" aria-label=\"ناوبری موبایل\"><a class=\"rounded-lg px-3 py-2 text-sm font-medium text-plum/80 hover:bg-primary-50\" href=\"/#classes\">کلاس‌ها</a><a class=\"rounded-lg px-3 py-2 text-sm font-medium text-plum/80 hover:bg-primary-50\" href=\"/#trainers\">مربیان</a><a class=\"rounded-lg px-3 py-2 text-sm font-medium text-plum/80 hover:bg-primary-50\" href=\"/#schedule\">برنامه هفتگی</a><a class=\"rounded-lg px-3 py-2 text-sm font-medium text-plum/80 hover:bg-primary-50\" href=\"/#gallery\">گالری</a><a class=\"rounded-lg px-3 py-2 text-sm font-medium text-plum/80 hover:bg-primary-50\" href=\"/#pricing\">تعرفه‌ها</a><a class=\"rounded-lg px-3 py-2 text-sm font-medium text-plum/80 hover:bg-primary-50\" href=\"/#testimonials\">نظرات</a><a class=\"rounded-lg px-3 py-2 text-sm font-medium text-plum/80 hover:bg-primary-50\" href=\"/#contact\">تماس</a><div class=\"mt-3 flex gap-3 border-t border-primary-100 pt-3\"><a class=\"flex-1 rounded-full border border-primary-200 px-4 py-2 text-center text-sm font-medium text-primary-700\" href=\"/login\">ورود</a><a class=\"flex-1 rounded-full bg-primary-500 px-4 py-2 text-center text-sm font-medium text-white\" href=\"/login\">ثبت‌نام</a></div></nav></div></header><main class=\"min-h-screen\"><main class=\"min-h-screen bg-cream\"><section class=\"bg-gradient-to-b from-primary-50 to-cream py-16\"><div class=\"container-site\"><div class=\"mx-auto mb-12 max-w-2xl text-center\"><span class=\"text-xs font-bold uppercase tracking-widest text-primary-500\">کلاس‌های ما</span><h2 class=\"mt-2 text-3xl font-bold text-plum sm:text-4xl\">انواع کلاس‌های باشگاه آوا</h2><p class=\"mt-3 text-base leading-7 text-plum/60\">روی هر کلاس کلیک کنید تا برنامه هفتگی، ساعت سانس‌ها و مربیان آن را ببینید.</p></div></div></section><section class=\"py-12\"><div class=\"container-site\"><div class=\"grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3\"><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">1<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">یوگا</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">یوگا تعادل میان ذهن و بدن را برقرار می‌کند؛ با تمرینات تنفس، انعطاف‌پذیری و آرامش عمیق، استرس روزمره را کاهش دهید و انرژی مثبت را به زندگی خود بازگردانید.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->زهرا قاسمی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/yoga\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">1<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">CX</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">کلاس CX یک تمرین ترکیبی و پرکثریت است که با حرکات فانکشنال، قدرت و استقامت قلب و عضلات را به‌شکل چشمگیری ارتقا می‌دهد؛ مناسب برای علاقه‌مندان به چالش‌های جدی بدنی.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->زهره قاسمی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/cx\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">2<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">بادی ریتم</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">بادی ریتم ترکیبی موزون از حرکات هوازی و کششی است که هماهنگی بدن، چابکی و فرم اندام را بهبود می‌بخشد؛ در فضایی پرانرژی همراه با موزیک.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->زهره قاسمی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/body-rhythm\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">1<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">بانجی ریتم</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">بانجی ریتم با استفاده از بندهای الاستیک، تمرینی سرگرم‌کننده و کم‌فشار بر مفاصل فراهم می‌کند که سوزاندن کالری، تقویت عضلات مرکزی و افزایش چابکی را به شکلی هیجان‌انگیز تجربه می‌کنید.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->خانم حسینی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/bunji-rhythm\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">3<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">ژیمناستیک</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">ژیمناستیک انعطاف‌پذیری، تعادل و قدرت عضلانی را در تمام سنین پرورش می‌دهد؛ از حرکات پایه تا تکنیک‌های پیشرفته، زیر نظر مربیان مجرب و در محیطی امن.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->خانم شریفی، آقای شریفی ۲، خانم یوسفلوئی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/gymnastics\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">3<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">TRX</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">تمرین با بندهای تعلیقی TRX با استفاده از وزن بدن، قدرت عملی، ثبات مرکزی و تعادل را تقویت می‌کند؛ شدت تمرین برای هر سطح قابل تنظیم است.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->خانم مانوری، زهرا قاسمی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/trx\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">1<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">کونگ فو / کیک بوکس</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">کونگ فو و کیک بوکس ترکیبی از هنرهای رزمی و تمرینات قدرتی است؛ دفاع شخصی را یاد بگیرید، سرعت واکنش و اعتمادبه‌نفس خود را چند برابر کنید.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->خانم حاجی زاده</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/kung-fu-kickboxing\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">2<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">کراس فیت</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">کراس فیت با WODهای متنوع و شدید، همه اجزای آمادگی جسمانی — قدرت، سرعت، استقامت و انعطاف — را همزمان توسعه می‌دهد؛ برای کسانی که دنبال تغییر واقعی هستند.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->خانم فرتوتی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/crossfit\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">1<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">ایروبیک</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">ایروبیک قلب و عروق را قوی می‌کند، کالری‌سوزی بالا و خلق‌وخو را شاداب می‌سازد؛ با حرکات ریتمیک گروهی، تناسب اندام را با انرژی و هیجان تجربه کنید.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->زهرا قاسمی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/aerobics\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">1<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">ترکیبی - ایروبیک</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">کلاس ترکیبی ایروبیک، حرکات هوازی را با تمرینات قدرتی و کششی ادغام می‌کند تا در یک جلسه کامل، چربی‌سوزی، فرم‌دهی و انعطاف همزمان اتفاق بیفتد.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->زهرا قاسمی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/aerobics-combo\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">2<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">تکواندو</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">تکواندو، هنر رزمی المپیکی، سرعت، تمرکز و انضباط را در شما تقویت می‌کند؛ ضربات پا و تکنیک‌های اصولی زیر نظر مربی رسمی فدراسیون تمرین می‌شود.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->خانم صادقی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/taekwondo\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">1<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">فیتنس بدنسازی</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">فیتنس بدنسازی با برنامه تمرینی هدفمند، فرم و تناسب اندام را ساخته و عضلات را تقویت می‌کند؛ ترکیب هوشمندانه‌ای از قدرت و زیبایی اندام.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->خانم حسینی</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/fitness-bodybuilding\">مشاهده جزئیات و سانس‌ها</a></div></article><article class=\"group flex flex-col justify-between rounded-3xl border border-primary-100 bg-white p-6 shadow-soft transition duration-300 hover:-translate-y-1 hover:border-primary-200\"><div><span class=\"inline-block rounded-full bg-accent/15 px-3 py-1 text-xs font-bold text-accent\">1<!-- --> سانس در هفته</span><h2 class=\"mt-3 text-xl font-bold text-plum\">کاراته کیوکوشین</h2><p class=\"mt-2 line-clamp-3 text-sm leading-7 text-plum/60\">کاراته کیوکوشین سبکی سخت‌کوش و پرفایده است؛ قدرت ضربه، استقامت ذهنی و انضباط اخلاقی را در کنار دفاع شخصی واقعی پرورش می‌دهد.</p></div><div class=\"mt-5\"><p class=\"mb-4 text-xs text-plum/50\">مربیان: <!-- -->خانم عسکری</p><a class=\"flex h-11 w-full items-center justify-center rounded-full bg-primary-500 text-sm font-bold text-white transition group-hover:bg-primary-600\" href=\"/classes/karate-kyokushin\">مشاهده جزئیات و سانس‌ها</a></div></article></div></div></section></main></main><footer class=\"bg-primary-800 text-primary-50\"><div class=\"container-site grid grid-cols-1 gap-10 py-12 sm:grid-cols-2 lg:grid-cols-4\"><div><div class=\"flex items-center gap-2 text-accent-light\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"24\" height=\"24\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" class=\"lucide lucide-dumbbell h-6 w-6 rotate-90\" aria-hidden=\"true\"><path d=\"M17.596 12.768a2 2 0 1 0 2.829-2.829l-1.768-1.767a2 2 0 0 0 2.828-2.829l-2.828-2.828a2 2 0 0 0-2.829 2.828l-1.767-1.768a2 2 0 1 0-2.829 2.829z\"></path><path d=\"m2.5 21.5 1.4-1.4\"></path><path d=\"m20.1 3.9 1.4-1.4\"></path><path d=\"M5.343 21.485a2 2 0 1 0 2.829-2.828l1.767 1.768a2 2 0 1 0 2.829-2.829l-6.364-6.364a2 2 0 1 0-2.829 2.829l1.768 1.767a2 2 0 0 0-2.828 2.829z\"></pa