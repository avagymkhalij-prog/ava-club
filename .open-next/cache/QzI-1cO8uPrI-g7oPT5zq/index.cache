{"type":"app","meta":{"headers":{"x-next-cache-tags":"_N_T_/layout,_N_T_/page,_N_T_/"}},"html":"<!DOCTYPE html><html lang=\"fa\" dir=\"rtl\"><head><meta charSet=\"utf-8\"/><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\"/><link rel=\"stylesheet\" href=\"/_next/static/css/be242b31a49bf824.css\" data-precedence=\"next\"/><link rel=\"preload\" as=\"script\" fetchPriority=\"low\" href=\"/_next/static/chunks/webpack-1ccb984bef8932a9.js\"/><script src=\"/_next/static/chunks/fd9d1056-a6af9eeeb31f5ac9.js\" async=\"\"></script><script src=\"/_next/static/chunks/117-085011db377e8295.js\" async=\"\"></script><script src=\"/_next/static/chunks/main-app-44fe08c68848fa24.js\" async=\"\"></script><script src=\"/_next/static/chunks/972-424429d3ad2bc017.js\" async=\"\"></script><script src=\"/_next/static/chunks/649-a996a0b34b144938.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/page-c9c02bd3e72b9265.js\" async=\"\"></script><script src=\"/_next/static/chunks/438-8687b529be8d9408.js\" async=\"\"></script><script src=\"/_next/static/chunks/993-880af5fae89bd981.js\" async=\"\"></script><script src=\"/_next/static/chunks/app/layout-cc6fa4975068d5a4.js\" async=\"\"></script><title>باشگاه آوا | باشگاه ورزشی بانوان</title><meta name=\"description\" content=\"باشگاه ورزشی بانوان آوا — کلاس‌های ایروبیک، کراس‌فیت، یوگا، پیلاتس، زومبا، TRX، فیتنس رقص و حرکات کششی در محیطی آرام و حرفه‌ای.\"/><meta name=\"keywords\" content=\"باشگاه بانوان,ایروبیک,یوگا,پیلاتس,زومبا,کراس‌فیت\"/><meta property=\"og:title\" content=\"باشگاه ورزشی بانوان آوا\"/><meta property=\"og:description\" content=\"کلاس‌های تخصصی ورزشی بانوان\"/><meta property=\"og:locale\" content=\"fa_IR\"/><meta property=\"og:type\" content=\"website\"/><meta name=\"twitter:card\" content=\"summary\"/><meta name=\"twitter:title\" content=\"باشگاه ورزشی بانوان آوا\"/><meta name=\"twitter:description\" content=\"کلاس‌های تخصصی ورزشی بانوان\"/><link rel=\"icon\" href=\"/favicon.ico\" type=\"image/x-icon